# Example Fail2ban Configuration
# Place this in /etc/fail2ban/jail.local

[DEFAULT]
# Ban hosts for specified time (in seconds)
bantime = 3600         # 1 hour

# Time window for counting retries (in seconds)  
findtime = 600         # 10 minutes

# Number of failures before ban
maxretry = 5

# Email notification settings (requires MTA like postfix)
destemail = root@localhost
sendername = Fail2Ban
# action = %(action_)s           # Ban only (no email) - default
# action = %(action_mw)s         # Ban and send email with whois (requires MTA)
action = %(action_mwl)s          # Ban and send email with logs (requires MTA)

# ===== JAILS =====

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3           # Stricter for SSH
bantime = 7200         # 2 hours ban for SSH

[sshd-ddos]
enabled = true
port = ssh
filter = sshd-ddos
logpath = /var/log/auth.log
maxretry = 2
bantime = 7200

# Optional: HTTP/HTTPS protection
# Uncomment if you're running a web server

# [nginx-http-auth]
# enabled = false
# port = http,https
# filter = nginx-http-auth
# logpath = /var/log/nginx/error.log

# [nginx-botsearch]
# enabled = false
# port = http,https
# filter = nginx-botsearch
# logpath = /var/log/nginx/access.log

# [nginx-badbots]
# enabled = false
# port = http,https
# filter = apache-badbots
# logpath = /var/log/nginx/access.log

# [nginx-noscript]
# enabled = false
# port = http,https
# filter = nginx-noscript
# logpath = /var/log/nginx/access.log

# [nginx-noproxy]
# enabled = false
# port = http,https
# filter = nginx-noproxy
# logpath = /var/log/nginx/access.log

# [php-url-fopen]
# enabled = false
# port = http,https
# filter = php-url-fopen
# logpath = /var/log/nginx/access.log

# To whitelist specific IPs, add them under [DEFAULT]:
# ignoreip = 127.0.0.1/8 ::1 YOUR_TRUSTED_IP
